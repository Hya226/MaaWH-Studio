{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maawh.local/schema/flow.schema.json",
  "title": "MaaWH Studio 流程定义（flows/*.flow.json）",
  "$comment": "结构校验。语义校验（模板是否存在、引用是否存在、命名空间冲突、无保护循环等）由 flow_editor.collect_issues / collect_pipeline_issues 负责，不在本 schema 里重复。",
  "type": "object",
  "required": ["name", "chain", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "enum": [ 1, 2, 3, 4 ], "$comment": "3 =【分支】命中出口只认显式连线；老文件由编辑器补连线后自动升级" },
    "name": { "type": "string", "minLength": 1 },
    "queue": {
      "enum": ["daily", "tools"],
      "$comment": "任务队列分类：daily=一键长草主队列、tools=小工具栏。注册/同步时写进清单条目的 group（App 按它决定任务在哪个标签页）。缺省=未指定：已有清单条目的分组不动，新追加的落小工具（老行为）。非法值由 normalize_flow 摘除"
    },
    "chain": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[^\\s\"'\\\\]+$",
        "$comment": "节点 id 只存在于编辑器内部（从不进 pipeline），import_pipelines 生成的 id 带中文，故只禁空白与引号；真正必须 ASCII 的是节点的 key 字段"
      },
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "$meta": { "type": "object" }
  },
  "$defs": {
    "nodeId": { "type": ["string", "null"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": { "type": "integer", "minimum": 0 },
        "next": { "$ref": "#/$defs/nodeId" },
        "mergeBack": {
          "type": "boolean",
          "$comment": "命中后内容跑完回并主线（不勾=内容跑完即结束）"
        },
        "t": {
          "type": "string",
          "$comment": "【已废弃】旧版候选自带的识别目标。判定条件现在取自候选连到的分支节点，此字段仅为兼容旧流程文件保留，读入后不再参与生成"
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["type", "x", "y", "props"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["tpl_click", "ocr_click", "tap", "swipe", "wait_tpl",
                   "branch", "detect_click", "switch", "loop", "subflow", "common", "startapp",
                   "input", "pick", "pass"]
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,32}$",
          "$comment": "pipeline 名后缀。缺省时按链序号生成，所以旧文件没有它也是合法的"
        },
        "title": { "type": "string" },
        "num": {
          "type": "integer",
          "minimum": 1,
          "$comment": "节点编号：新建时分配、之后固定不变（不再随链序变化），同时是 pipeline 名后缀 _<num>。缺省时按链序推算，所以旧文件没有它也是合法的"
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "next": {
          "$ref": "#/$defs/nodeId",
          "$comment": "本节点的「下一个」（v4 起是显式的边）：链序只决定显示顺序，连接一律看它。缺省/空 = 到此结束。老文件（schemaVersion<4）由 normalize_flow 按当时的链序补出来，生成结果不变"
        },
        "hit_next": { "$ref": "#/$defs/nodeId" },
        "miss_next": { "$ref": "#/$defs/nodeId" },
        "cut": {
          "type": "boolean",
          "$comment": "「此处断开」：本节点不再接链上后继。写在【节点级】（不是 props 里），编辑器点「下一个 → 无：到此结束」或把节点移出主链时会给前一个节点打上它。链尾节点不需要这个标记"
        },
        "props": { "$ref": "#/$defs/props" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "branch" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "required": ["threshold", "timeout"],
                "properties": {
                  "template": { "type": "string" },
                  "ocr_text": { "type": "string" },
                  "threshold": { "type": "number" },
                  "timeout": { "type": "integer" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "detect_click" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "required": ["threshold", "timeout"],
                "properties": {
                  "template": { "type": "string" },
                  "ocr_text": { "type": "string" },
                  "threshold": { "type": "number" },
                  "timeout": { "type": "integer" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "switch" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "required": ["candidates"],
                "properties": {
                  "candidates": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/candidate" }
                  },
                  "miss_next": { "$ref": "#/$defs/nodeId" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "common" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "required": ["node"],
                "properties": { "node": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      ]
    },
    "props": {
      "type": "object",
      "$comment": "字段随节点类型不同；这里只约束跨类型共用的可选流程字段，其余放开。",
      "properties": {
        "enabled": { "type": "boolean" },
        "max_hit": { "type": ["integer", "string"] },
        "notes": { "type": "string" },
        "timeout": { "type": ["integer", "string"] },
        "roi": { "type": "string" },
        "threshold": { "type": ["number", "string"] },
        "template": { "type": "string" },
        "text": { "type": "string" },
        "expected": { "type": "string" },
        "ocr_text": { "type": "string" },
        "order_by": { "type": ["string", "boolean"] },
        "index": { "type": ["integer", "string"] },
        "replace": { "type": "string" },
        "only_rec": { "type": "boolean" },
        "rate_limit": { "type": ["integer", "string"] },
        "pre_delay": { "type": ["integer", "string"] },
        "post_delay": { "type": ["integer", "string"] },
        "pre_wait_freezes": { "type": ["integer", "string"] },
        "post_wait_freezes": { "type": ["integer", "string"] },
        "repeat": { "type": ["integer", "string"] },
        "repeat_delay": { "type": ["integer", "string"] },
        "x": { "type": ["integer", "string"] },
        "y": { "type": ["integer", "string"] },
        "x1": { "type": ["integer", "string"] },
        "y1": { "type": ["integer", "string"] },
        "x2": { "type": ["integer", "string"] },
        "y2": { "type": ["integer", "string"] },
        "duration": { "type": ["integer", "string"] },
        "package": { "type": "string" },
        "node": { "type": "string" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate" }
        },
        "miss_next": { "$ref": "#/$defs/nodeId" }
      }
    }
  }
}
