# ── Python 缓存 ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/

# ── 编辑器/框选工具产物 ──────────────────────────────────────
# flows/*.flow.json 是流程定义（唯一数据源，必须入库）；
# flows/build/ 是编辑器生成物，可重新生成，不入库
flows/build/
*.tmp
*.bak
*.bak.*
*.bak_*
flows_backup_*/
_tmp/

# ── 日志与临时状态 ───────────────────────────────────────────
*.log
recent.txt
# 编辑器的小偏好（删除免确认等）—— 本机状态，每个人不一样
ui_prefs.json
# adb 路径与手机序列号 —— 每台电脑不一样（见 device_config.py）
device.json

# ── 调试用帧图/裁图（下划线开头，如 _check_frame.png）────────
_*.png
_*.jpg
pick_frame.jpg

# ── 密钥 / 凭据（绝不入库）──────────────────────────────────
*.keystore
*.jks
*.pepk
*.p12
*.pfx
*.pem
*.key
id_rsa*
id_ed25519*
.env
.env.*
secrets*.json
credentials*.json
*token*.json

# ── 系统垃圾文件 ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
